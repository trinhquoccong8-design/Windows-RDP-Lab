
name: Windows Runner Check

on:
  workflow_dispatch:

jobs:
  windows-check:
    runs-on: windows-latest

    steps:
      - name: Check Windows
        shell: pwsh
        run: |
          Write-Host "Windows Runner Started"
          Get-ComputerInfo |
            Select-Object WindowsProductName, WindowsVersion, OsArchitecture
          Write-Host "Windows Runner Ready"
